<Window x:Class="lplayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:lplayer.Controls"
        Title="lplayer"
        Width="880" Height="420"
        MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="#FAFAFA"
        Foreground="#111111"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="FgBrush" Color="#111111"/>
        <SolidColorBrush x:Key="SubBrush" Color="#777777"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#EEEEEE"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEEEEE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#4C8DFF"/>
            <Setter Property="BorderBrush" Value="#4C8DFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A7AEE"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6BD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FAFAFA" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：文件名 + 文件夹 -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12" HorizontalAlignment="Center">
            <TextBlock x:Name="FileNameText"
                       Text="{Binding FileName}"
                       Foreground="#111111"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="720"
                       ToolTip="{Binding FullPathTooltip}"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding FolderPath}"
                       Foreground="#777777"
                       FontSize="11"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="720"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#777777"
                       FontSize="11"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 中部：波形 -->
        <Border Grid.Row="1" Margin="24,8,24,8">
            <controls:WaveformControl x:Name="Waveform"
                                      Peaks="{Binding Waveform.Peaks, Mode=OneWay}"
                                      Position="{Binding Position, Mode=OneWay}"
                                      Duration="{Binding Duration, Mode=OneWay}"
                                      PlayedBrush="#4C8DFF"
                                      RestBrush="#D8D8D8"
                                      SeekCommand="{Binding SeekToPositionCommand}"
                                      BeginDragCommand="{Binding BeginSeekCommand}"
                                      EndDragCommand="{Binding EndSeekCommand}"
                                      DragUpdateCommand="{Binding DragUpdateCommand}"
                                      MouseEnter="Waveform_MouseEnter"
                                      MouseLeave="Waveform_MouseLeave"/>
        </Border>

        <!-- 底部：时间 + 控制键 -->
        <Grid Grid.Row="2" Margin="20,8,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TimeText}"
                       Foreground="#777777"
                       FontSize="12"
                       FontFamily="{StaticResource AppFontMono}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 后退时移：← + 秒数 -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding SeekBackCommand}"
                        ToolTip="后退时移">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Settings.SeekSeconds, StringFormat='{}{0}s'}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 播放 / 暂停 -->
                <Button Style="{StaticResource AccentButton}"
                        Padding="18,8"
                        MinWidth="52"
                        Command="{Binding PlayPauseCommand}"
                        Content="{Binding PlayPauseIconText}"
                        ToolTip="播放 / 暂停 (空格)"/>

                <!-- 前进时移：秒数 + → -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding SeekForwardCommand}"
                        ToolTip="前进时移">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Settings.SeekSeconds, StringFormat='{}{0}s'}"
                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="→" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 倍速 -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding CycleRateCommand}"
                        Content="{Binding RateButtonText}"
                        ToolTip="倍速（点击循环切换）"/>

                <!-- 音频属性 -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding OpenPropertiesCommand}"
                        Content="属性"
                        ToolTip="音频属性"/>

                <!-- 设置 -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Content="设置"
                        ToolTip="设置"/>

                <!-- 关于 -->
                <Button Style="{StaticResource ToolButton}"
                        Command="{Binding OpenAboutCommand}"
                        Content="关于"
                        ToolTip="关于 lplayer"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
