<Window x:Class="lplayer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 — lplayer"
        Width="380"
        SizeToContent="Height"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        Foreground="#111111"
        FontFamily="{StaticResource AppFont}"
        FontSize="13">
    <StackPanel Margin="28,24,28,20">

        <TextBlock Text="lplayer"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="#111111"
                   HorizontalAlignment="Center"/>

        <TextBlock x:Name="VersionText"
                   Text="v1.0.0"
                   FontSize="12"
                   Foreground="#777777"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>

        <TextBlock Text="轻量、纯粹的本地音乐播放器"
                   FontSize="12"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>

        <!-- 作者栏：头像 + 名字 + 链接 -->
        <Border Margin="0,24,0,0"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 作者头像 64x64（Assets/avatar.png，缺失时占位） -->
                <Border Grid.Column="0"
                        Width="64" Height="64" CornerRadius="32"
                        Background="#F0F0F0"
                        BorderBrush="#DDDDDD" BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="♫"
                                   FontSize="24"
                                   Foreground="#4C8DFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="AvatarImage"
                               Width="64" Height="64"
                               Stretch="UniformToFill"
                               Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="作者"
                               FontSize="11" Foreground="#777777"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="lyx-star"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#111111"/>
                    <TextBlock Margin="0,6,0,0">
                        <Hyperlink x:Name="GithubLink"
                                   NavigateUri="https://github.com/lyx-star"
                                   RequestNavigate="Github_RequestNavigate"
                                   Foreground="#4C8DFF"
                                   FontSize="12"
                                   TextDecorations="None">
                            github.com/lyx-star
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Button Content="关闭" HorizontalAlignment="Center" Margin="0,22,0,0"
                Padding="28,8" Background="Transparent" Foreground="#111111"
                BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"
                Click="Close_Click"/>
    </StackPanel>
</Window>
