<Window x:Class="lplayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — lplayer"
        Width="420" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        Foreground="#111111"
        FontFamily="{StaticResource AppFont}"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#111111"/>
        <SolidColorBrush x:Key="Sub" Color="#777777"/>
        <SolidColorBrush x:Key="Border" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEEEEE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A7AEE"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6BD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,16">
        <StackPanel>

            <!-- 时移时长 -->
            <TextBlock Text="时移时长（秒）" Style="{StaticResource SectionTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton Style="{StaticResource Radio}" Content="2"  GroupName="seek" Tag="2"
                             IsChecked="{Binding SeekChoice2, Mode=TwoWay}" Margin="0,4,10,4" Checked="Seek_Checked"/>
                <RadioButton Style="{StaticResource Radio}" Content="5"  GroupName="seek" Tag="5"
                             IsChecked="{Binding SeekChoice5, Mode=TwoWay}" Margin="0,4,10,4" Checked="Seek_Checked"/>
                <RadioButton Style="{StaticResource Radio}" Content="10" GroupName="seek" Tag="10"
                             IsChecked="{Binding SeekChoice10, Mode=TwoWay}" Margin="0,4,10,4" Checked="Seek_Checked"/>
                <RadioButton Style="{StaticResource Radio}" Content="15" GroupName="seek" Tag="15"
                             IsChecked="{Binding SeekChoice15, Mode=TwoWay}" Margin="0,4,10,4" Checked="Seek_Checked"/>
                <RadioButton Style="{StaticResource Radio}" Content="20" GroupName="seek" Tag="20"
                             IsChecked="{Binding SeekChoice20, Mode=TwoWay}" Margin="0,4,10,4" Checked="Seek_Checked"/>
                <RadioButton Style="{StaticResource Radio}" Content="30" GroupName="seek" Tag="30"
                             IsChecked="{Binding SeekChoice30, Mode=TwoWay}" Margin="0,4,4,4" Checked="Seek_Checked"/>
            </StackPanel>

            <!-- 文件关联 -->
            <TextBlock Text="文件关联" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="将 MP3 / WAV / FLAC / M4A / AAC / OGG / WMA 关联到 lplayer。&#x0a;写入当前用户注册表（HKCU），一般无需管理员。&#x0a;Windows 11 可能仍要求在“默认应用”中确认。"
                       Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="一键关联支持的音频格式" Style="{StaticResource AccentBtn}"
                        Click="Associate_Click" Margin="0,0,8,0"/>
                <Button Content="解除关联" Style="{StaticResource FlatBtn}"
                        Click="Dissociate_Click"/>
            </StackPanel>

            <!-- 系统默认应用 -->
            <TextBlock Text="打开 Windows 默认应用设置" Style="{StaticResource SectionTitle}"/>
            <Button Content="打开默认应用" Style="{StaticResource FlatBtn}" Click="OpenDefaultApps_Click"
                    HorizontalAlignment="Left"/>

            <!-- 关于入口 -->
            <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
            <Button Content="关于 lplayer" Style="{StaticResource FlatBtn}" Click="About_Click"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <Button Content="关闭" Style="{StaticResource FlatBtn}"
                    HorizontalAlignment="Right" Margin="0,20,0,0" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
